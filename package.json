{
  "name": "balabol",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ./**/*.{ts,tsx}",
    "db:migrate": "cd ./apps/backend && drizzle-kit migrate"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "prettier": "3.10.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
