{
  "name": "balabol",
  "devDependencies": {
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "prettier": "3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "cd ./apps/backend && drizzle-kit migrate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
