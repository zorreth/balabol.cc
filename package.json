{
  "name": "balabol",
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
